// With splitting flows
fork1Flow := flow.Flow("fork1").
    WithHandler(
        flow.Handler("forkHandler").
            WithHandleFunc(f)
    )
fork2Flow := flow.Flow("fork2").
    WithHandler(
        flow.Handler("forkHandler").
            WithHandleFunc(f)
    )

app := flow.App("myApp").
    WithFlows(
        flow.Flow("myFlow").
            WithHandler(
                flow.Handler[int, string]("handler1").
                    WithHandleFunc(f)
            ).
            WithHandler(
                flow.SplitHandler[string]("splitter").
                    WithFlow(fork1Flow).
                    WithFlow(fork2Flow).
                    WithHandleFunc(f)
            ),
    ).
    Build()
